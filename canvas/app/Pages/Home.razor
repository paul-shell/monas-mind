@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Visual · Mona</PageTitle>

<main class="mona-stage">
    <canvas @ref="canvas" tabindex="0" aria-label="Three-dimensional cat head wireframe. Drag to rotate and scroll to zoom."></canvas>
    @if (graphError is not null) { <div class="graph-error" role="alert">@graphError</div> }
    <div id="source-count" class="source-count" role="status">Loading saved sources</div>
    <div class="view-controls" role="group" aria-label="View controls">
        <button type="button" aria-label="Zoom out" title="Zoom out" disabled="@(!graphReady)" @onclick="() => Zoom(false)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
        </button>
        <button type="button" aria-label="Reset view" title="Reset zoom and orientation" disabled="@(!graphReady)" @onclick="ResetView">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6L4 9m0-5v5h5" /></svg>
        </button>
        <button type="button" aria-label="Zoom in" title="Zoom in" disabled="@(!graphReady)" @onclick="() => Zoom(true)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
        </button>
        <button type="button" aria-label="Auto-rotate" title="Toggle auto-rotation" aria-pressed="@(autoRotate ? "true" : "false")" disabled="@(!graphReady)" @onclick="ToggleRotation">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12c0-2.4 4-4 9-4s9 1.6 9 4-4 4-9 4c-1.4 0-2.7-.1-3.9-.4M4 15l-1-3 3-1M20 9l1 3-3 1" /></svg>
        </button>
        <button type="button" aria-label="Demo" title="Toggle demo notes" aria-pressed="@(demoMode ? "true" : "false")" disabled="@(!graphReady)" @onclick="ToggleDemo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5zM9 9l6 3-6 3z" /></svg>
        </button>
    </div>
    <div class="note-slider">
        @if (demoMode) {
            <label for="note-count">Demo notes <span><output for="note-count">@demoCount.ToString("N0")</output> / 1,000,000</span></label>
            <input id="note-count" type="range" min="0" max="1000000" step="100" value="@demoCount" @oninput="ChangeDemoCount" />
        }
        <label class="transparent-toggle"><span>Transparent</span><input type="checkbox" checked="@transparent" @onchange="ChangeTransparency" disabled="@(!graphReady)" /></label>
        <label for="wire-opacity">Wireframe opacity <output for="wire-opacity">@wireOpacity%</output></label>
        <input id="wire-opacity" type="range" min="0" max="100" step="1" value="@wireOpacity" disabled="@(!graphReady)" @oninput="ChangeWireOpacity" />
    </div>
    <div class="hint">Drag to rotate · scroll to zoom</div>
    <div class="fps" aria-label="Performance monitor">
        <div><span id="graph-fps">Sampling FPS</span> · <span id="graph-frame-time">sampling frame time</span></div>
        <div id="graph-system">CPU / RAM: identifying canvas</div>
        <div id="graph-gpu">GPU: identifying canvas</div>
    </div>
</main>

@code {
    private ElementReference canvas;
    private IJSObjectReference? module;
    private string? graphError;
    private bool graphReady;
    private bool autoRotate = true;
    private int wireOpacity = 25;
    private bool transparent = true;
    private async Task ChangeTransparency(ChangeEventArgs e) {
        var enabled = e.Value is true;
        if (await InvokeControl("setTransparent", enabled)) transparent = enabled;
    }
    private bool demoMode;
    private int demoCount = 1000;
    private async Task ToggleDemo() {
        if (await InvokeControl("setDemoMode", !demoMode, demoCount)) demoMode = !demoMode;
    }
    private async Task ChangeDemoCount(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out var count)) {
            demoCount = Math.Clamp(count, 0, 1000000);
            await InvokeControl("setNoteCount", demoCount);
        }
    }
    private async Task ChangeWireOpacity(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out var opacity)) {
            wireOpacity = Math.Clamp(opacity, 0, 100);
            await InvokeControl("setWireOpacity", wireOpacity);
        }
    }
    private async Task<bool> InvokeControl(string name, params object?[] args) {
        if (module is null) return false;
        try {
            await module.InvokeVoidAsync(name, args);
            return true;
        } catch (JSException) {
            graphError = "The view controls couldn't update the visual.";
            graphReady = false;
            return false;
        }
    }
    private async Task Zoom(bool zoomIn) => await InvokeControl("zoom", zoomIn);
    private async Task ResetView() => await InvokeControl("resetView");
    private async Task ToggleRotation() {
        if (await InvokeControl("setAutoRotate", !autoRotate)) autoRotate = !autoRotate;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./wireframe-mona.js");
            await module.InvokeVoidAsync("start", canvas, Http.BaseAddress!.ToString());
            await module.InvokeVoidAsync("setAutoRotate", autoRotate);
            graphReady = true;
            await InvokeAsync(StateHasChanged);
        } catch (JSException) {
            graphError = "The visual couldn't start.";
            await InvokeAsync(StateHasChanged);
        }
    }
    public async ValueTask DisposeAsync() {
        if (module is not null) {
            try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
            catch (JSException) { }
        }
    }
}
